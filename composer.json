{
    "name": "magdicom/laravel-hooks",
    "description": "Laravel integration for Hooks with container resolution, dependency injection, a facade, and the hooks() helper.",
    "keywords": [
        "magdicom",
        "laravel",
        "laravel-hooks",
        "hooks",
        "actions",
        "filters",
        "collectors",
        "processors",
        "renderers"
    ],
    "homepage": "https://hooks.momagdi.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Magdi",
            "email": "m@momagdi.com",
            "homepage": "https://momagdi.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "magdicom/hooks": "^2.0.0-beta.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.11",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.2 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Magdicom\\LaravelHooks\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Magdicom\\LaravelHooks\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "test": "vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Magdicom\\LaravelHooks\\ServiceProvider"
            ],
            "aliases": {
                "Hooks": "Magdicom\\LaravelHooks\\Facades\\Hooks"
            }
        }
    },
    "support": {
        "issues": "https://github.com/magdicom/laravel-hooks/issues",
        "source": "https://github.com/magdicom/laravel-hooks"
    },
    "prefer-stable": true
}
